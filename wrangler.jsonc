{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irreza",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7e5d76d4-497d-4f2b-971e-c83de335bf02","database_name": "irreza" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "10bb6c7bb4054d68b80ac5dc43abd01e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
